# UPA Lorena — raiz do public_html
#
# Instalação (uma vez, manual via FTP/cPanel):
#   1. Envie este arquivo para:
#        public_html/.htaccess
#      (renomeie para .htaccess se o cliente FTP esconder o ponto)
#   2. Envie hosting/wp-content-uploads.htaccess para:
#        public_html/wp/wp-content/uploads/.htaccess
#      (cache longo das mídias do WordPress — hero, logos de parceiros, etc.)
#
# NÃO coloque este arquivo dentro de public_html/website/
# O deploy do Astro vai só para website/; este arquivo fica na raiz.
# O site Astro também leva public/.htaccess → website/.htaccess (cache de
# /_astro e /images) automaticamente a cada build.
#
# Efeito:
#   www → apex (301)
#   upalorena.com.br/        → website/index.html
#   upalorena.com.br/pagina/ → website/pagina/
#   upalorena.com.br/wp/     → WordPress (intacto)
#   HSTS + cache de assets estáticos
#
# Validação pós-deploy (deve aparecer Cache-Control: max-age=31536000):
#   curl -sI https://upalorena.com.br/images/logo-upa-lorena.png
#   curl -sI https://upalorena.com.br/wp/wp-content/uploads/2018/04/herob.jpg
#   curl -sI "https://upalorena.com.br/_astro/" # pegue um .woff2 do HTML

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical: www → apex (HTTP e HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.upalorena\.com\.br$ [NC]
  RewriteRule ^ https://upalorena.com.br%{REQUEST_URI} [L,R=301]

  # WordPress em /wp — não reescreve
  RewriteRule ^wp(/|$) - [L]

  # Acesso direto a /website/ (e arquivos internos do deploy)
  RewriteRule ^website(/|$) - [L]

  # Home do domínio → site Astro
  RewriteRule ^$ /website/ [L]

  # Demais rotas → pasta website/, sem mostrar /website na URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ /website/$1 [L]
</IfModule>

# HSTS — só em conexões HTTPS
<IfModule mod_headers.c>
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  </If>
</IfModule>

# Cache de assets estáticos na raiz / fallback (CSS, JS, imagens, fontes, SVG).
# Uploads do WP: ver hosting/wp-content-uploads.htaccess
# Assets do Astro: ver public/.htaccess → website/.htaccess
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|webp|avif|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 404 do site estático (Astro)
ErrorDocument 404 /website/404.html

# Evita listagem de diretórios na raiz
Options -Indexes
