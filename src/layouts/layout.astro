      content="A União Protetora dos Animais de Lorena é uma organização sem fins lucrativos com propósito de acolher, tratar e encaminhar para adoção os animais abandonados."
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
      <Donation donations={globalData?.upa_donations} />
      <Volunteer content={globalData?.upa_volunteers} />
      <Sponsors
        sponsors={globalData?.upa_colab_list}
        description={globalData?.upa_colab_about}
      />
    </main>
    <Footer />
  </body>
