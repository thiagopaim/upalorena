---
import "@fontsource/amatic-sc/latin-400.css";
import "@fontsource/amatic-sc/latin-700.css";
import amatic400 from "@fontsource/amatic-sc/files/amatic-sc-latin-400-normal.woff2?url";
import amatic700 from "@fontsource/amatic-sc/files/amatic-sc-latin-700-normal.woff2?url";
import josefinLatin from "@fontsource-variable/josefin-sans/files/josefin-sans-latin-wght-normal.woff2?url";
import Header from "../components/header.astro";
import Donation from "../components/donation.astro";
import Volunteer from "../components/volunteer.astro";
import Sponsors from "../components/sponsors.astro";
import Footer from "../components/footer.astro";
import { fetchWp } from "../lib/wp-api";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const DEFAULT_DESCRIPTION =
  "A União Protetora dos Animais de Lorena é uma organização sem fins lucrativos com propósito de acolher, tratar e encaminhar para adoção os animais abandonados.";

const { title, description = DEFAULT_DESCRIPTION, image } = Astro.props;

const siteOrigin = Astro.site?.origin ?? "https://upalorena.com.br";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteOrigin);
const ogImageURL = new URL(
  image ?? "/images/logo-upa-lorena.png",
  Astro.site ?? siteOrigin,
).href;
const logoURL = new URL("/images/logo-upa-lorena.png", Astro.site ?? siteOrigin)
  .href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "UPA - União Protetora dos Animais de Lorena",
  alternateName: "UPA Lorena",
  url: siteOrigin,
  logo: logoURL,
  email: "contato@upalorena.com.br",
  description: DEFAULT_DESCRIPTION,
  areaServed: {
    "@type": "City",
    name: "Lorena",
    containedInPlace: {
      "@type": "State",
      name: "São Paulo",
    },
  },
};

interface AcfOptions {
  acf: {
    upa_donations: {
      upa_donation_item: string;
      upa_donation_application: string;
      upa_donation_address: string;
    }[];
    upa_volunteers: string;
    upa_colab_about: string; // Adicionando caso precise para sponsors/colaboradores
    upa_colab_list: {
      upa_colab_list_item: {
        url: string;
        alt: string;
        title: string;
        width: number;
        height: number;
      };
      upa_colab_list_item_address: string;
    }[];
  };
}

let globalData: AcfOptions["acf"] | null = null;

try {
  const response = await fetchWp("/acf/v3/options/options");
  if (response.ok) {
    const data = (await response.json()) as AcfOptions;
    globalData = data.acf;
  }
} catch (error) {
  console.error("Error fetching global options:", error);
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8f2f4" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/logo-upa-lorena.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="UPA Lorena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <link
      rel="preload"
      href={amatic400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={amatic700}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={josefinLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
      <Donation donations={globalData?.upa_donations} />
      <Volunteer content={globalData?.upa_volunteers} />
      <Sponsors
        sponsors={globalData?.upa_colab_list}
        description={globalData?.upa_colab_about}
      />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import url("../styles/reset.css");
  @import url("../styles/variables.css");
  @import url("../styles/video.css");

  body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    line-height: 160%;
    color: var(--color-text);
    overflow-x: hidden;
  }

  h1 {
    margin: 0px 0px 15px;
    font-family: "Amatic SC", sans-serif;
    font-size: 4rem;
    line-height: 100%;
    color: var(--color-prim);
  }

  h2 {
    margin: 0px 0px 15px;
    font-family: "Amatic SC", sans-serif;
    font-size: 3rem;
    line-height: 100%;
    color: var(--color-prim);
  }

  p {
    margin: 0 0 15px;
    font-size: 1rem;
    line-height: 160%;
  }

  ul {
    padding: 0px 0px 0px 20px;
    list-style: disc;
  }

  img {
    display: block;
    line-height: 100%;
    margin: 0;
  }

  a {
    color: var(--color-prim);
  }

  /* image + caption */
  .alignleft {
    margin: 5px 15px 15px 0px;
    float: left;
  }

  .wp-caption img {
    display: inline-block;
    border-radius: var(--radius) var(--radius) 0 0;
    border: 1px solid var(--color-back-dark);
    vertical-align: middle;
  }

  .wp-caption .wp-caption-text {
    max-width: calc(100% - 10px);
    border-radius: 0 0 var(--radius) var(--radius);
    font-size: 0.75rem;
    padding: 5px;
    background-color: var(--color-back-dark);
    text-align: center;
  }

  img:is([sizes="auto" i], [sizes^="auto," i]) {
    contain: size !important;
    contain-intrinsic-size: 300px 150px;
  }

  @media screen and (max-width: 989px) {
    h1 {
      font-size: 3rem;
    }

    h2 {
      font-size: 2.5rem;
    }
  }
</style>
