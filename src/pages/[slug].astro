---
import Layout from "../layouts/layout.astro"
import { fetchWp } from "../lib/wp-api"

interface WordPressPage {
  id: number
  status: string
  link: string
  title: { rendered: string }
  content: { rendered: string }
  excerpt?: { rendered: string }
  menu_order?: number
}

function stripHtml(html: string): string {
  return html
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim()
}

function pageDescription(page: WordPressPage): string | undefined {
  const fromExcerpt = page.excerpt?.rendered
    ? stripHtml(page.excerpt.rendered)
    : ""
  if (fromExcerpt) return fromExcerpt.slice(0, 220)

  const fromContent = stripHtml(page.content.rendered)
  if (!fromContent) return undefined
  return fromContent.slice(0, 220)
}

export async function getStaticPaths() {
  const response = await fetchWp("/wp/v2/pages?per_page=100&_fields=id,status,link,title,menu_order,content,excerpt&orderby=menu_order&order=asc")

  if (!response.ok) {
    return []
  }

  const data = (await response.json()) as WordPressPage[]

  const pages = data.filter((page) => page.status === "publish")

  return pages.flatMap((page) => {
    const url = new URL(page.link)
    const normalizedPath = url.pathname.replace(/^\/wp\//, "/").replace(/\/+$/, "")
    const segments = normalizedPath.split("/").filter(Boolean)
    const slug = segments[segments.length - 1]

    // Home (path vazio) já é servida por index.astro; slug vazio é inválido em [slug].astro
    if (!slug || slug === "home") {
      return []
    }

    return [{
      params: { slug },
      props: { page },
    }]
  })
}

interface Props {
  page: WordPressPage
}

const { page } = Astro.props as Props
const description = pageDescription(page)
---

<Layout
  title={`${page.title.rendered} | UPA - União Protetora dos Animais`}
  description={description}
>
  <section class="page">
    <h1>{page.title.rendered}</h1>
    <article class="page-content" set:html={page.content.rendered} />
  </section>
</Layout>

<style>
  .page {
    max-width: var(--max-width);
    padding: 60px 15px 0;
    margin: 0 auto;
  }

  .page-content {
    margin-top: 24px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .page-content a {
    color: var(--color-prim);
    text-decoration: underline;
  }
</style>
